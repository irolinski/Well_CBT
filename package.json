    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "i18next": "^24.2.2",
    "jest-expo": "53.0.14",
    "nativewind": "^2.0.11",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "react-dom": "19.1.0",
